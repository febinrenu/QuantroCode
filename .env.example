APP_NAME="Quantro"
APP_ENV=production
APP_KEY=base64:uBgcuc74ba7iCFYvxSW+GwZc6A0eDcgLFj+opqHXCUU=
APP_DEBUG=true
APP_URL=https://quantrocore.com
LOG_CHANNEL=stack

APP_SUPER_ADMIN_EMAIL=superadmin@stockysaas.site
APP_SUPER_ADMIN_PASSWORD=123456

FLUTTERWAVE_REDIRECT_URL=

# Free key from https://unsplash.com/oauth/applications — used only by
# `php artisan demo:industry-catalog` to fetch real product photos.
UNSPLASH_ACCESS_KEY=


MAIL_MAILER=smtp
MAIL_HOST=mail.stockysaas.site
MAIL_PORT=465
MAIL_USERNAME=noreply@stockysaas.site
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@stockysaas.site
MAIL_FROM_NAME="Stocky SaaS"

APP_TIMEZONE="UTC"

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=quantrocousr_dbx7
# DB_USERNAME=quantrocousr_usr1
# DB_PASSWORD="F(}BMysWaTL~8RHK"
# DB_COLLATION=utf8mb4_unicode_ci

DUMP_PATH=mysqldump

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_DOMAIN intentionally unset — middleware handles per-request

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


STRIPE_KEY=
STRIPE_SECRET=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

NEXMO_KEY=
NEXMO_SECRET=
NEXMO_FROM=

base_url=
api_key=
sender_from=

TERMI_KEY=""
TERMI_SECRET=""
TERMI_SENDER=


WOO_TIMEOUT_MS_BATCH=30000

# QUEUE_CONNECTION is set to `sync` above (single source of truth). Jobs run
# inline — no worker or `jobs` table required. Switch to `database` ONLY if you
# run a persistent queue worker AND the `jobs` table exists in the queue's DB.
QUEUE_RETRY_AFTER=1200

# Woo sync batching + stuck detection
WOO_PRODUCTS_PER_JOB=2
WOO_SYNC_STUCK_SECONDS=600
WOO_SYNC_QUEUE_WAIT_SECONDS=1800

# Woo API retries (transient failures only)
WOO_HTTP_RETRIES=2
WOO_HTTP_RETRY_BASE_MS=300
WOO_MAX_CONSECUTIVE_FAILURES=7

# WP media (big images on shared hosting)
WOO_WP_MEDIA_SEARCH_TIMEOUT=15
WOO_WP_MEDIA_UPLOAD_TIMEOUT=240
WOO_WP_MEDIA_RETRIES=2
WOO_WP_MEDIA_RETRY_SLEEP_MS=500

WOO_STOCK_PRODUCTS_PER_JOB=3
WOO_POLL_TICK_MAX_SECONDS=300
WOO_WP_MEDIA_UPLOAD_TIMEOUT=240

WOO_REMOTE_INDEX_PAGE_CAP=500
WOO_SKU_SEARCH_PAGE_CAP=10

WOO_ALLOW_ALT_SKU_ON_LOOKUP_CONFLICT=false
















































































































